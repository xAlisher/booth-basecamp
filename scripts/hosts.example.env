# Copy to scripts/hosts.local.env (gitignored) and fill in. Used by scripts/mac.sh.
# Never commit real hostnames or IPs.

# The Mac that builds and tests the darwin-arm64 module (user@host).
MAC_HOST=user@mac.local
# Optional ssh jump host when the Mac is only reachable through another box (user@host); empty = direct.
MAC_JUMP=
# Where the repo is synced on the Mac (relative to the Mac user's home).
MAC_DIR=booth-basecamp
